# Do not commit an actual .env file or secrets.
POSTGRES_USER=growlab
POSTGRES_PASSWORD=CHANGE_ME_TO_LONG_RANDOM_PASSWORD
# Optional, disabled unless valid provider credentials exist:
YOUTUBE_API_KEY=
GROWTH_AI_API_KEY=
GROWTH_AI_MODEL=gpt-4o-mini
# Internal HMAC signed settlement event integration only — NOT a real payment provider.
GROWTH_WEBHOOK_SECRET=

# Display recipient bank transfer instructions only when account + holder are configured.
GROWTH_BANK_ACCOUNT_NUMBER=
GROWTH_BANK_ACCOUNT_HOLDER=
# NEVER set this until a trusted provider adapter has verified actual bank settlement.
GROWTH_BANK_SETTLEMENT_SECRET=

# Casso Flow Webhook V2 (requires account-linked provider and explicit live launch)
GROWTH_CASSO_ENABLED=false
GROWTH_CASSO_WEBHOOK_SECRET=
GROWTH_LIVE_PAYMENTS_READY=false
# Legacy custom verified adapter; keep off unless explicitly using a trusted adapter.
GROWTH_INTERNAL_VERIFIED_ENABLED=false
